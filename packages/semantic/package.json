  "scripts": {
    "build": "tsup && npm run build:types",
    "generate:grammar": "tsx scripts/generate-nearley-grammar.ts",
    "check:grammar": "tsx scripts/generate-nearley-grammar.ts --check",
    "generate:mapper-parity": "tsx scripts/gen-mapper-parity.ts",
    "check:mapper-parity": "tsx scripts/gen-mapper-parity.ts --check",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "build:browser": "tsup src/browser.ts --format iife --global-name LokaScriptSemantic --minify",
    "dev": "tsup --watch",
    "pretest": "../../scripts/ensure-fresh.sh ../intent ../framework",
    "test": "bash ../../scripts/vitest-run.sh",
    "test:run": "vitest run",
    "test:check": "VITEST_QUIET=1 bash ../../scripts/vitest-run.sh --reporter=dot",
    "test:coverage": "bash ../../scripts/vitest-run.sh --coverage",
    "typecheck": "tsc --noEmit",
    "add-language": "npx tsx scripts/add-language.ts",
    "update-keywords": "npx tsx scripts/update-keywords.ts",
    "generate:indexes": "npx tsx scripts/generate-indexes.ts",
    "prebuild": "npm run generate:indexes",
    "benchmark": "npx tsx scripts/benchmark-all.ts",
    "benchmark:json": "npx tsx scripts/benchmark-all.ts --json",
    "benchmark:save": "npx tsx scripts/benchmark-all.ts --save",
    "benchmark:ci": "npx tsx scripts/benchmark-all.ts --save --compare",
    "benchmark:lookup": "npx tsx scripts/benchmark-tokenizer-lookup.ts",
    "generate:language-assets": "npx tsx scripts/generate-language-assets.ts"
  },
  "sideEffects": [
    "./src/languages/*.ts",
    "./dist/languages/*.js",
    "./src/patterns/index.ts",
    "./src/lexicons/*.ts",
    "./dist/lexicons/*.js"
  ],
  "keywords": [
    "hyperscript",
    "semantic",
    "multilingual",
    "i18n",
    "parser",
    "natural-language"
  ],
  "author": "LokaScript Contributors",
  "license": "MIT",
  "dependencies": {
    "@lokascript/framework": "^2.11.1",
    "nearley": "^2.20.1"
  },
  "devDependencies": {
    "@types/nearley": "^2.11.5",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.0.17",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codetalcott/hyperfixi.git",
    "directory": "packages/semantic"
  },
  "bugs": {
    "url": "https://github.com/codetalcott/hyperfixi/issues"
  },
  "homepage": "https://github.com/codetalcott/hyperfixi/tree/main/packages/semantic#readme",
  "engines": {
