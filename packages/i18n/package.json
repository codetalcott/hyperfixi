{
  "name": "@lokascript/i18n",
  "version": "2.10.0",
  "description": "Grammar transformation and keyword translation for hyperscript",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./dictionaries": {
      "types": "./dist/dictionaries/index.d.ts",
      "import": "./dist/dictionaries/index.js",
      "require": "./dist/dictionaries/index.cjs"
    },
    "./plugins/vite": {
      "types": "./dist/plugins/vite.d.ts",
      "import": "./dist/plugins/vite.js",
      "require": "./dist/plugins/vite.cjs"
    },
    "./plugins/webpack": {
      "types": "./dist/plugins/webpack.d.ts",
      "import": "./dist/plugins/webpack.js",
      "require": "./dist/plugins/webpack.cjs"
    }
  },
  "scripts": {
    "build": "tsup && npm run build:browser",
    "build:browser": "rollup -c rollup.config.mjs",
    "dev": "tsup --watch",
    "test": "bash ../../scripts/vitest-run.sh",
    "test:check": "VITEST_QUIET=1 bash ../../scripts/vitest-run.sh --reporter=dot",
    "test:coverage": "bash ../../scripts/vitest-run.sh --coverage",
    "typecheck": "tsc --noEmit",
    "validate-dictionaries": "npx tsx ../testing-framework/src/vocab/cli.ts validate --check V1,V1b --warn-only"
  },
  "browser": "dist/lokascript-i18n.min.js",
  "sideEffects": false,
  "keywords": [
    "hyperscript",
    "i18n",
    "internationalization",
    "translation",
    "localization"
  ],
  "author": "LokaScript Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codetalcott/hyperfixi.git",
    "directory": "packages/i18n"
  },
  "bugs": {
    "url": "https://github.com/codetalcott/hyperfixi/issues"
  },
  "homepage": "https://github.com/codetalcott/hyperfixi/tree/main/packages/i18n#readme",
  "devDependencies": {
    "@lokascript/semantic": "^2.10.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.0.0",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.10.6",
    "rollup": "^4.62.2",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.5"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "@lokascript/semantic": "^2.10.0",
    "node-html-parser": "^6.1.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "@lokascript/semantic": {
      "optional": true
    },
    "node-html-parser": {
      "optional": true
    }
  }
}
