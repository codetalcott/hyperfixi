{
  "name": "@hyperfixi/core",
  "version": "4.4.0",
  "description": "Hyperscript: @hyperfixi/engine, its script-tag bundle, and the multilingual and editor tooling around it",
  "type": "module",
  "main": "dist/index.mjs",
  "unpkg": "dist/hyperfixi.js",
  "jsdelivr": "dist/hyperfixi.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./browser": "./dist/hyperfixi.js",
    "./multilingual": {
      "types": "./dist/multilingual/index.d.ts",
      "import": "./dist/multilingual/index.mjs",
      "require": "./dist/multilingual/index.cjs"
    },
    "./package.json": "./package.json",
    "./reference": {
      "types": "./dist/reference/index.d.ts",
      "import": "./dist/reference/index.mjs",
      "require": "./dist/reference/index.cjs"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.mjs",
      "require": "./dist/metadata.cjs"
    },
    "./lsp-metadata": {
      "types": "./dist/lsp-metadata.d.ts",
      "import": "./dist/lsp-metadata.mjs",
      "require": "./dist/lsp-metadata.cjs"
    },
    "./ast-utils": {
      "types": "./dist/ast-utils/index.d.ts",
      "import": "./dist/ast-utils/index.mjs",
      "require": "./dist/ast-utils/index.cjs"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rollup -c && tsc -p tsconfig.build.json",
    "build:types": "tsc -p tsconfig.build.json",
    "build:browser": "node scripts/build-browser-bundles.mjs",
    "build:browser:main-only": "node scripts/copy-engine-bundle.mjs",
    "snapshot:bundle-size": "node scripts/bundle-size-snapshot.mjs --check",
    "snapshot:bundle-size:update": "node scripts/bundle-size-snapshot.mjs --update",
    "dev": "rollup -c -w",
    "test": "bash ../../scripts/vitest-run.sh",
    "test:watch": "vitest",
    "test:coverage": "bash ../../scripts/vitest-run.sh --coverage",
    "test:ui": "vitest --ui",
    "test:browser": "npm run build:browser && npx playwright test --project=full",
    "test:browser:smoke": "node scripts/check-dist-freshness.mjs && npx playwright test --project=smoke --reporter=list",
    "test:browser:quick": "npm run build:browser && npx playwright test --project=quick --reporter=list",
    "test:browser:integration": "node scripts/check-dist-freshness.mjs && npx playwright test --project=integration --reporter=list",
    "test:browser:commands": "node scripts/check-dist-freshness.mjs && npx playwright test --project=commands --reporter=list",
    "test:browser:expressions": "node scripts/check-dist-freshness.mjs && npx playwright test --project=expressions --reporter=list",
    "test:browser:i18n": "node scripts/check-dist-freshness.mjs && npx playwright test --project=i18n --reporter=list",
    "test:browser:bundles": "node scripts/check-dist-freshness.mjs && npx playwright test --project=bundles --reporter=list",
    "test:browser:gallery": "node scripts/check-dist-freshness.mjs && npx playwright test --project=gallery --reporter=list",
    "test:browser:ui": "node scripts/check-dist-freshness.mjs && npx playwright test --ui",
    "check:dist-freshness": "node scripts/check-dist-freshness.mjs",
    "test:comprehensive": "npm run build:browser && npx playwright test --grep '@comprehensive' --reporter=list",
    "test:check": "VITEST_QUIET=1 bash ../../scripts/vitest-run.sh --reporter=dot",
    "test:quick": "npm run build:browser && bash ../../scripts/vitest-run.sh --reporter=dot",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "clean": "rm -rf dist",
    "verify:reference": "tsx scripts/verify-reference-data.ts",
    "update:sizes": "tsx scripts/update-bundle-sizes.ts",
    "update:sizes:auto": "tsx scripts/update-bundle-sizes.ts --update"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.2",
    "happy-dom": "^20.14.5",
    "http-server": "^14.1.1",
    "rollup": "^4.63.5",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^5.0.2"
  },
  "keywords": [
    "hyperscript",
    "_hyperscript",
    "multilingual",
    "dom",
    "typescript"
  ],
  "author": "LokaScript Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codetalcott/hyperfixi.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/codetalcott/hyperfixi/issues"
  },
  "homepage": "https://github.com/codetalcott/hyperfixi/tree/main/packages/core#readme",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hyperfixi/engine": "^4.4.0",
    "@lokascript/semantic": "^4.4.0"
  },
  "directories": {
    "doc": "docs"
  }
}
