{
  "name": "@lokascript/language-server",
  "version": "7.5.1",
  "description": "Language Server Protocol implementation for LokaScript/hyperscript with 24 language support",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "lokascript-language-server": "./dist/server.js"
  },
  "scripts": {
    "build": "tsup src/server.ts --format esm --clean",
    "start": "node dist/server.js --stdio",
    "dev": "tsx src/server.ts --stdio",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "test:check": "npm run pretest --silent && VITEST_QUIET=1 bash ../../scripts/vitest-run.sh --reporter=dot",
    "pretest": "bash ../../scripts/ensure-fresh.sh ../intent ../framework ../semantic ../engine ../core && npm run build --silent"
  },
  "keywords": [
    "lsp",
    "language-server",
    "hyperscript",
    "lokascript",
    "vscode",
    "ide",
    "multilingual"
  ],
  "author": "LokaScript Contributors",
  "license": "MIT",
  "dependencies": {
    "@lokascript/framework": "^7.5.1",
    "@lokascript/semantic": "^7.5.1",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  },
  "peerDependencies": {
    "@hyperfixi/core": "^7.5.1",
    "@hyperfixi/engine": "^7.5.1"
  },
  "peerDependenciesMeta": {
    "@hyperfixi/core": {
      "optional": true
    },
    "@hyperfixi/engine": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hyperfixi/core": "^7.5.1",
    "@hyperfixi/engine": "^7.5.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codetalcott/hyperfixi.git",
    "directory": "packages/language-server"
  },
  "bugs": {
    "url": "https://github.com/codetalcott/hyperfixi/issues"
  },
  "homepage": "https://github.com/codetalcott/hyperfixi/tree/main/packages/language-server#readme"
}
