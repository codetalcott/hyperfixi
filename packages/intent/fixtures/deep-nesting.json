[
  {
    "id": "deep-002",
    "description": "3-level nesting: event-handler > conditional > thenBranch command",
    "jsonInput": {
      "kind": "event-handler",
      "action": "on",
      "roles": {
        "event": {
          "type": "literal",
          "value": "submit",
          "dataType": "string"
        }
      },
      "body": [
        {
          "kind": "command",
          "action": "if",
          "roles": {
            "condition": {
              "type": "expression",
              "raw": "isValid"
            }
          },
          "thenBranch": [
            {
              "kind": "command",
              "action": "add",
              "roles": {
                "patient": {
                  "type": "selector",
                  "value": ".success"
                }
              }
            }
          ],
          "elseBranch": [
            {
              "kind": "command",
              "action": "add",
              "roles": {
                "patient": {
                  "type": "selector",
                  "value": ".error"
                }
              }
            }
          ]
        }
      ]
    },
    "expectedRoundTrip": true,
    "expectedDepth": 3
  }
]
