{
  "name": "lokascript-vscode",
  "displayName": "Hyperscript Language Support",
  "description": "Language support for _hyperscript and LokaScript — syntax highlighting, completions, hover docs, diagnostics, and 24 language i18n",
  "version": "4.4.0",
  "publisher": "lokascript",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "hyperscript",
    "_hyperscript",
    "lokascript",
    "htmx",
    "html",
    "multilingual"
  ],
  "activationEvents": [
    "onLanguage:html"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "hyperscript",
        "aliases": [
          "Hyperscript",
          "LokaScript"
        ],
        "extensions": [
          ".hs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hyperscript",
        "scopeName": "source.hyperscript",
        "path": "./syntaxes/hyperscript.tmLanguage.json"
      },
      {
        "scopeName": "inline.hyperscript",
        "path": "./syntaxes/hyperscript-injection.tmLanguage.json",
        "injectTo": [
          "text.html.basic",
          "text.html.derivative",
          "text.html.vue",
          "source.vue",
          "source.svelte"
        ],
        "embeddedLanguages": {
          "meta.embedded.inline.hyperscript": "hyperscript"
        }
      }
    ],
    "snippets": [
      {
        "language": "hyperscript",
        "path": "./snippets/hyperscript.code-snippets"
      },
      {
        "language": "html",
        "path": "./snippets/hyperscript.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "lokascript.showInMyLanguage",
        "title": "LokaScript: Show in My Language"
      },
      {
        "command": "lokascript.restartServer",
        "title": "LokaScript: Restart Language Server"
      },
      {
        "command": "lokascript.inventory",
        "title": "HyperFixi: Open Template Inventory",
        "icon": "$(list-tree)"
      },
      {
        "command": "lokascript.inventory.stop",
        "title": "HyperFixi: Stop Template Inventory",
        "icon": "$(stop)"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Hyperscript",
      "properties": {
        "lokascript.mode": {
          "type": "string",
          "enum": [
            "auto",
            "hyperscript",
            "hyperscript-i18n",
            "lokascript"
          ],
          "enumDescriptions": [
            "Detect based on available packages",
            "Restrict to _hyperscript-compatible syntax, English only",
            "Restrict to _hyperscript-compatible syntax with multilingual support (for hyperscript-adapter users)",
            "Allow all LokaScript features including extensions"
          ],
          "default": "auto",
          "description": "Operating mode for syntax validation."
        },
        "lokascript.language": {
          "type": "string",
          "default": "en",
          "description": "Primary language for keyword suggestions (en, es, ja, ko, zh, de, fr, pt, ar, etc.)"
        },
        "lokascript.maxDiagnostics": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of diagnostics to show per file"
        },
        "lokascript.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server"
        },
        "lokascript.inventory.port": {
          "type": "number",
          "default": 4200,
          "description": "Port for the Template Inventory server"
        },
        "lokascript.reviewLanguage": {
          "type": "string",
          "default": "",
          "description": "Language code for 'Show in My Language' (e.g. ko, ja, es). Empty = ask each time."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run generate:grammar && npm run compile && npm run bundle:server",
    "compile": "esbuild src/extension.ts --bundle --format=cjs --outfile=dist/extension.js --platform=node --external:vscode",
    "watch": "esbuild src/extension.ts --bundle --format=cjs --outfile=dist/extension.js --platform=node --external:vscode --watch",
    "typecheck": "tsc --noEmit",
    "generate:grammar": "npx tsx scripts/generate-grammar.ts",
    "bundle:server": "esbuild ../language-server/src/server.ts --bundle --format=esm --outfile=dist/server.mjs --platform=node --alias:@lokascript/semantic/fidelity=../../packages/semantic/src/fidelity.ts --alias:@lokascript/semantic=../../packages/semantic/src/index.ts --alias:@lokascript/framework=../../packages/framework/src/index.ts --alias:@hyperfixi/core/lsp-metadata=../../packages/core/src/lsp-metadata.ts --alias:@hyperfixi/core/ast-utils=../../packages/core/src/ast-utils/index.ts --alias:@hyperfixi/engine=../../packages/engine/src/index.ts --banner:js=\"import {createRequire} from 'module';const require=createRequire(import.meta.url);\"",
    "package": "npx --yes @vscode/vsce@^3.9.1 package --no-dependencies",
    "publish": "npx --yes @vscode/vsce@^3.9.1 publish --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@lokascript/semantic": "^4.4.0",
    "@types/node": "^26.6.3",
    "@types/vscode": "^1.138.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codetalcott/hyperfixi.git",
    "directory": "packages/vscode-extension"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/codetalcott/hyperfixi/issues"
  },
  "homepage": "https://github.com/codetalcott/hyperfixi/tree/main/packages/vscode-extension#readme"
}
