{
  "name": "@hyperfixi/engine",
  "version": "3.2.0",
  "private": true,
  "description": "A small, typed hyperscript engine, faithful to upstream _hyperscript: its test suite is the acceptance oracle",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test:upstream": "node upstream-suite/run.mjs --bundle dist/full.js --check",
    "test:upstream:update": "node upstream-suite/run.mjs --bundle dist/full.js --update",
    "test:own": "node upstream-suite/run.mjs --bundle dist/full.js --own",
    "cost": "node cost.mjs"
  },
  "author": "LokaScript Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codetalcott/hyperfixi.git",
    "directory": "packages/engine"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.25.12",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
