{
  "name": "@hyperfixi/developer-tools",
  "version": "7.6.0",
  "private": true,
  "sideEffects": false,
  "description": "Private tooling for this repository: the template inventory and the Prism highlighter the example pages load",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./prism-hyperscript-i18n": {
      "types": "./dist/prism-hyperscript-i18n/index.d.ts",
      "import": "./dist/prism-hyperscript-i18n/index.mjs",
      "require": "./dist/prism-hyperscript-i18n/index.js"
    },
    "./prism-hyperscript-i18n/browser": {
      "types": "./dist/prism-hyperscript-i18n/browser.d.ts",
      "import": "./dist/prism-hyperscript-i18n/browser.mjs",
      "require": "./dist/prism-hyperscript-i18n/browser.js"
    },
    "./prism-hyperscript-i18n/themes/light.css": "./src/prism-hyperscript-i18n/themes/light.css",
    "./prism-hyperscript-i18n/themes/dark.css": "./src/prism-hyperscript-i18n/themes/dark.css"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:check": "VITEST_QUIET=1 bash ../../scripts/vitest-run.sh --reporter=dot"
  },
  "keywords": [
    "hyperscript",
    "hyperfixi",
    "prism",
    "syntax-highlighting",
    "i18n"
  ],
  "author": "LokaScript Contributors",
  "license": "MIT",
  "dependencies": {
    "@lokascript/i18n": "^7.6.0",
    "chokidar": "^4.0.3",
    "express": "^5.3.0",
    "glob": "^13.0.6",
    "open": "^11.0.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^9.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "prismjs": "^1.29.0"
  },
  "peerDependenciesMeta": {
    "prismjs": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src"
  ]
}
