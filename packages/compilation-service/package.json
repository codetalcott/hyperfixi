{
  "name": "@lokascript/compilation-service",
  "version": "7.5.0",
  "description": "Semantic service for LokaScript - validates, translates, diffs and scores hyperscript from 24 languages, explicit syntax, or LLM JSON",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "pretest": "../../scripts/ensure-fresh.sh ../semantic ../engine",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:check": "VITEST_QUIET=1 bash ../../scripts/vitest-run.sh --reporter=dot",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lokascript/framework": "^7.5.0"
  },
  "devDependencies": {
    "@hyperfixi/engine": "^7.5.0",
    "@lokascript/semantic": "^7.5.0",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^5.3.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@lokascript/semantic": "^7.5.0",
    "@hyperfixi/engine": "^7.5.0"
  },
  "peerDependenciesMeta": {
    "@lokascript/semantic": {
      "optional": false
    },
    "@hyperfixi/engine": {
      "optional": true
    }
  },
  "keywords": [
    "hyperscript",
    "lokascript",
    "compilation",
    "semantic",
    "multilingual",
    "llm",
    "http",
    "edge"
  ],
  "author": "LokaScript Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codetalcott/hyperfixi.git",
    "directory": "packages/compilation-service"
  }
}
