{
  "name": "@hyperfixi/vite-plugin",
  "version": "7.5.1",
  "description": "Vite plugin for automatic tree-shaken hyperscript bundles",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "files": [
    "dist/",
    "client.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "../../scripts/ensure-fresh.sh ../engine ../core",
    "test": "bash ../../scripts/vitest-run.sh",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "sync-keywords": "npx tsx scripts/sync-keywords.ts",
    "check:keywords": "npx tsx scripts/sync-keywords.ts --check",
    "sync-htmx-vocab": "npx tsx scripts/sync-htmx-vocab.ts",
    "test:check": "VITEST_QUIET=1 bash ../../scripts/vitest-run.sh --reporter=dot"
  },
  "peerDependencies": {
    "@hyperfixi/server-bridge": "^7.5.1",
    "vite": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@hyperfixi/server-bridge": {
      "optional": true
    }
  },
  "dependencies": {
    "@hyperfixi/engine": "^7.5.1",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "hyperscript",
    "hyperfixi",
    "bundler",
    "zero-config"
  ],
  "author": "LokaScript Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codetalcott/hyperfixi.git",
    "directory": "packages/vite-plugin"
  },
  "bugs": {
    "url": "https://github.com/codetalcott/hyperfixi/issues"
  },
  "homepage": "https://github.com/codetalcott/hyperfixi/tree/main/packages/vite-plugin#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
