{
  "name": "@hyperfixi/speech",
  "version": "4.3.0",
  "description": "The speak command (Web Speech API) for @hyperfixi/engine, as an engine module (upstream _hyperscript 0.9.90).",
  "type": "module",
  "sideEffects": false,
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "pretest": "../../scripts/ensure-fresh.sh ../engine",
    "build": "tsup && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly --outDir dist --noEmit false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:check": "VITEST_QUIET=1 bash ../../scripts/vitest-run.sh --reporter=dot",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@hyperfixi/engine": "^4.3.0"
  },
  "devDependencies": {
    "@hyperfixi/engine": "^4.3.0",
    "@types/node": "^26.6.3",
    "happy-dom": "^20.14.5",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.2"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "hyperfixi",
    "hyperscript",
    "speech-synthesis",
    "_hyperscript",
    "v0.9.90",
    "engine-module"
  ],
  "author": "LokaScript Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codetalcott/hyperfixi.git",
    "directory": "packages/speech"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
