{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lse-wire-format",
  "title": "LSE Wire Format",
  "description": "LokaScript Explicit Syntax JSON interchange format. `kind` defaults to \"command\" when absent. `trigger` is convenience sugar for event handlers. LSE 3.0: commands and simple handlers. See protocol/spec/wire-format.md.",
  "$defs": {
    "SelectorValue": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "selector"
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "selectorKind": {
          "enum": ["id", "class", "attribute", "element", "complex"]
        },
        "implicit": {
          "const": true,
          "description": "Supplied by the parser from the command's default, not written by the author. A renderer leaves an implicit value out."
        }
      }
    },
    "LiteralValue": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "literal"
        },
        "value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "dataType": {
          "enum": ["string", "number", "boolean", "duration"]
        },
        "implicit": {
          "const": true,
          "description": "Supplied by the parser from the command's default, not written by the author. A renderer leaves an implicit value out."
        },
        "quoted": {
          "const": true,
          "description": "Written in quotes where a bare word was possible; written back in quotes."
        },
        "interpolates": {
          "const": true,
          "description": "A naked ${…} URL; written back naked."
        }
      }
    },
    "ReferenceValue": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "reference"
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "implicit": {
          "const": true,
          "description": "Supplied by the parser from the command's default, not written by the author. A renderer leaves an implicit value out."
        }
      }
    },
    "ExpressionValue": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "expression"
        },
        "raw": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "implicit": {
          "const": true,
          "description": "Supplied by the parser from the command's default, not written by the author. A renderer leaves an implicit value out."
        }
      },
      "anyOf": [
        {
          "required": ["raw"]
        },
        {
          "required": ["value"]
        }
      ]
    },
    "PropertyPathValue": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "property-path"
        },
        "value": {
          "type": "string",
          "description": "The older shape: the whole path as one string, read as an expression."
        },
        "implicit": {
          "const": true,
          "description": "Supplied by the parser from the command's default, not written by the author. A renderer leaves an implicit value out."
        },
        "object": {
          "$ref": "#/$defs/SemanticValue",
          "description": "The owner: any value."
        },
        "property": {
          "type": "string",
          "minLength": 1
        },
        "access": {
          "enum": ["dot", "possessive"],
          "description": "Which spelling was read: #a.b or #a's b."
        }
      },
      "anyOf": [
        {
          "required": ["object", "property"]
        },
        {
          "required": ["value"]
        }
      ]
    },
    "FlagValue": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "flag"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "value": {
          "type": "boolean"
        },
        "implicit": {
          "const": true,
          "description": "Supplied by the parser from the command's default, not written by the author. A renderer leaves an implicit value out."
        }
      },
      "anyOf": [
        {
          "required": ["name", "enabled"]
        },
        {
          "required": ["value"]
        }
      ]
    },
    "SemanticValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/SelectorValue"
        },
        {
          "$ref": "#/$defs/LiteralValue"
        },
        {
          "$ref": "#/$defs/ReferenceValue"
        },
        {
          "$ref": "#/$defs/ExpressionValue"
        },
        {
          "$ref": "#/$defs/PropertyPathValue"
        },
        {
          "$ref": "#/$defs/FlagValue"
        }
      ]
    },
    "RolesObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/SemanticValue"
      }
    },
    "Trigger": {
      "type": "object",
      "required": ["event"],
      "properties": {
        "event": {
          "type": "string",
          "minLength": 1
        },
        "modifiers": {
          "type": "object"
        }
      }
    },
    "Diagnostic": {
      "type": "object",
      "required": ["level", "role", "message", "code"],
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": ["error", "warning"]
        },
        "role": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      }
    },
    "Annotation": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        }
      }
    },
    "CommandNode": {
      "type": "object",
      "required": ["action", "roles"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "command",
          "default": "command"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "$ref": "#/$defs/RolesObject"
        },
        "trigger": {
          "$ref": "#/$defs/Trigger"
        },
        "thenBranch": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemanticNode"
          }
        },
        "elseBranch": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemanticNode"
          }
        },
        "loopVariant": {
          "enum": ["forever", "times", "for", "while", "until"]
        },
        "loopBody": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemanticNode"
          }
        },
        "loopVariable": {
          "type": "string"
        },
        "indexVariable": {
          "type": "string"
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemanticNode"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Annotation"
          }
        }
      }
    },
    "EventHandlerNode": {
      "type": "object",
      "required": ["kind", "action", "roles", "body"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "event-handler"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "$ref": "#/$defs/RolesObject"
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemanticNode"
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Annotation"
          }
        }
      }
    },
    "CompoundNode": {
      "type": "object",
      "required": ["kind", "action", "statements"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "compound"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "$ref": "#/$defs/RolesObject"
        },
        "statements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemanticNode"
          }
        },
        "chainType": {
          "enum": ["then", "and", "async", "sequential"]
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Annotation"
          }
        }
      }
    },
    "SemanticNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/CommandNode"
        },
        {
          "$ref": "#/$defs/EventHandlerNode"
        },
        {
          "$ref": "#/$defs/CompoundNode"
        }
      ]
    }
  },
  "$ref": "#/$defs/SemanticNode"
}
